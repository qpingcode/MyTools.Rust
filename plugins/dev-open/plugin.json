{
  "id": "dev-open",
  "name": {
    "key": "name",
    "defaultValue": "Open in IDE"
  },
  "version": "0.0.1",
  "type": "search",
  "entry": "mytools-dev-open",
  "icon": "builtin:square-code",
  "alias": [
    "ide"
  ],
  "search": {
    "global": true
  },
  "contributes": {
    "commands": [
      {
        "id": "open-selection",
        "title": {
          "key": "command.open_selection",
          "defaultValue": "Open Selected Project in IDE"
        },
        "input": [
          "attachment-files"
        ]
      },
      {
        "id": "build-project",
        "title": {
          "key": "command.build_project",
          "defaultValue": "Build Selected Project"
        },
        "keywords": ["build", "dotnet", "csproj", "编译"],
        "icon": "builtin:square-terminal",
        "input": ["attachment-files"]
      },
      {
        "id": "build-solution",
        "title": {
          "key": "command.build_solution",
          "defaultValue": "Build Selected Solution"
        },
        "keywords": ["build", "dotnet", "sln", "solution", "编译", "解决方案"],
        "icon": "builtin:package",
        "input": ["attachment-files"]
      }
    ],
    "actions": [
      {
        "when": { "type": ["file", "folder"] },
        "actions": [
          {
            "command": "rider",
            "title": { "key": "action.rider", "defaultValue": "Open in Rider" },
            "icon": "builtin:square-code"
          },
          {
            "command": "vscode",
            "title": { "key": "action.vscode", "defaultValue": "Open in VS Code" },
            "icon": "builtin:code-xml"
          },
          {
            "command": "visualstudio",
            "title": { "key": "action.visualstudio", "defaultValue": "Open in Visual Studio" },
            "icon": "builtin:code"
          },
          {
            "command": "build-project",
            "title": { "key": "action.build_project", "defaultValue": "Build Project" },
            "icon": "builtin:square-terminal"
          },
          {
            "command": "build-solution",
            "title": { "key": "action.build_solution", "defaultValue": "Build Solution" },
            "icon": "builtin:package"
          }
        ]
      }
    ]
  }
}
