// Ask AI 配置。复制为同目录的 config.json 后修改；支持 // 和 /* */ 注释。
// 修改后无需重启，下一次提问时生效。API 密钥只从环境变量 DEEPSEEK_API_KEY 读取。
{
  // OpenAI 兼容的对话接口地址，插件会请求 <base_url>/chat/completions。
  //   "https://api.deepseek.com"  DeepSeek 官方（默认）
  "base_url": "https://api.deepseek.com",

  // 模型名称；环境变量 DEEPSEEK_MODEL 优先于此项。
  //   "deepseek-flash"  默认，速度快
  //   其他取值以所用服务的模型列表为准
  "model": "deepseek-flash",

  // 系统提示词：告诉模型它的角色和回答方式。留空使用默认。
  "system_prompt": "",

  // 一次回答最多多少 token，超过时回答会被截断。
  "max_tokens": 8192
}
