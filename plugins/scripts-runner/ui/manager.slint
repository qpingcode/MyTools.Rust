import { LineEdit, TextEdit, ScrollView, Palette } from "std-widgets.slint";
import { Theme } from "../../../ui/theme.slint";
import { I18n } from "../../../ui/i18n.slint";
import { Icon } from "../../../ui/components/icon.slint";
export { I18n } from "../../../ui/i18n.slint";

/// One saved script as shown in the sidebar.
export struct ScriptRow {
    name: string,
    alias: string,
    /// "ps1" or "cmd".
    kind: string,
}

component ToolButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> enabled: true;
    /// "primary", "secondary", "ghost" or "danger".
    in property <string> kind: "secondary";
    /// Optional keyboard shortcut shown dimmed after the text.
    in property <string> shortcut;
    callback clicked();
    private property <color> fg: !root.enabled ? Theme.disabled
        : root.kind == "danger" ? #ffffff
        : root.kind == "ghost" && touch.has-hover ? Theme.foreground
        : root.kind == "ghost" ? Theme.muted
        : Theme.foreground;
    height: 32px;
    // Buttons size to their content instead of sharing the row's spare width.
    width: layout.preferred-width;
    horizontal-stretch: 0;
    border-radius: 6px;
    border-width: root.kind == "secondary" ? 1px : 0px;
    border-color: Theme.border;
    background: !root.enabled ? (root.kind == "primary" ? Theme.primary.transparentize(0.6) : transparent)
        : root.kind == "primary" ? (touch.pressed ? Theme.primary : touch.has-hover ? Theme.primary-hover : Theme.primary)
        : root.kind == "danger" ? (touch.has-hover ? #c9504b : #b0403c)
        : touch.pressed ? Theme.selected
        : touch.has-hover ? Theme.hover
        : root.kind == "ghost" ? transparent : Theme.panel;
    animate background { duration: 90ms; }
    layout := HorizontalLayout {
        padding-left: root.text == "" ? 8px : 12px;
        padding-right: root.text == "" ? 8px : 14px;
        spacing: 7px;
        alignment: center;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon { name: root.icon; width: 15px; height: 15px; tint: root.fg; }
        }
        if root.text != "": Text {
            text: root.text; color: root.fg; font-size: Theme.font-body;
            vertical-alignment: center;
        }
        if root.shortcut != "": Text {
            text: root.shortcut; color: root.fg.transparentize(0.4); font-size: Theme.font-caption;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
}

component ScriptItem inherits Rectangle {
    in property <ScriptRow> script;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked();
    height: 50px;
    border-radius: 8px;
    background: root.selected ? Theme.selected : touch.has-hover && root.enabled ? Theme.hover : transparent;
    animate background { duration: 90ms; }
    Rectangle {
        x: 0px; y: (parent.height - self.height) / 2;
        width: 3px; height: 22px; border-radius: 2px;
        background: Theme.accent;
        visible: root.selected;
    }
    HorizontalLayout {
        padding-left: 12px; padding-right: 10px; spacing: 11px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 30px; height: 30px; border-radius: 7px;
                background: Theme.icon-background;
                Icon {
                    x: 7px; y: 7px; width: 16px; height: 16px;
                    name: root.script.kind == "cmd" ? "builtin:square-terminal" : "builtin:file-code";
                }
            }
        }
        VerticalLayout {
            alignment: center; spacing: 3px;
            Text {
                text: root.script.name; color: Theme.foreground; font-size: Theme.font-body;
                overflow: elide;
            }
            Text {
                text: (root.script.kind == "cmd" ? "CMD" : "PowerShell") + (root.script.alias == "" ? "" : "  ·  " + root.script.alias);
                color: Theme.muted; font-size: Theme.font-caption; overflow: elide;
            }
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    accessible-role: list-item;
    accessible-label: root.script.name;
    accessible-item-selected: root.selected;
}

component FieldLabel inherits Text {
    color: Theme.muted;
    font-size: Theme.font-small;
}

/// A two-option toggle, used for the script type.
component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current;
    in property <bool> enabled: true;
    height: 32px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.panel;
    HorizontalLayout {
        padding: 3px; spacing: 3px;
        for option[index] in root.options: Rectangle {
            border-radius: 4px;
            background: index == root.current ? Theme.primary : option-touch.has-hover && root.enabled ? Theme.hover : transparent;
            animate background { duration: 90ms; }
            Text {
                text: option;
                color: !root.enabled ? Theme.disabled : index == root.current ? Theme.foreground : Theme.muted;
                font-size: Theme.font-body;
                horizontal-alignment: center; vertical-alignment: center;
            }
            option-touch := TouchArea {
                enabled: root.enabled;
                mouse-cursor: pointer;
                clicked => { root.current = index; }
            }
        }
    }
}

export component ScriptManager inherits Window {
    title: I18n.text("manage");
    icon: @image-url("../../../ui/assets/app.png");
    preferred-width: 980px; preferred-height: 660px;
    min-width: 780px; min-height: 520px;
    background: Theme.background;
    default-font-family: "Microsoft YaHei UI";
    in property <[ScriptRow]> scripts;
    in property <int> selected: -1;
    in-out property <string> script-name;
    in-out property <string> alias;
    in-out property <int> kind;
    in-out property <string> content;
    in-out property <string> directory;
    /// The values last loaded or saved; the form is dirty when it differs from them.
    in property <string> saved-name;
    in property <string> saved-alias;
    in property <int> saved-kind;
    in property <string> saved-content;
    in property <string> saved-directory;
    // A binding rather than `changed` handlers, which run after the Rust side has finished
    // loading a script and would mark a freshly opened script as modified.
    out property <bool> dirty: root.script-name != root.saved-name || root.alias != root.saved-alias
        || root.kind != root.saved-kind || root.content != root.saved-content
        || root.directory != root.saved-directory;
    in-out property <bool> deleting;
    in property <bool> saved;
    in property <bool> busy;
    in property <bool> windows;
    in property <string> status;
    callback choose(int);
    callback create();
    callback save();
    callback discard();
    callback remove();
    callback execute(bool);
    // Editing cancels a pending "confirm delete".
    changed dirty => { root.deleting = false; }
    // Standard text widgets follow the dark launcher theme instead of the light default.
    init => { Palette.color-scheme = ColorScheme.dark; }
    private property <bool> runnable: root.saved && !root.dirty && !root.busy && root.windows;

    FocusScope {
        capture-key-pressed(event) => {
            if (event.modifiers.control && (event.text == "s" || event.text == "S")) {
                if (!root.busy) { root.save(); }
                return accept;
            }
            return reject;
        }
        HorizontalLayout {
            // Sidebar: the saved scripts.
            Rectangle {
                width: 268px;
                background: Theme.panel;
                VerticalLayout {
                    padding: 16px; padding-top: 20px; spacing: 14px;
                    HorizontalLayout {
                        padding-left: 4px; spacing: 8px;
                        Text {
                            text: I18n.text("name"); color: Theme.foreground;
                            font-size: Theme.font-heading; font-weight: 600;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 20px; width: max(20px, count.preferred-width + 12px);
                                border-radius: 10px; background: Theme.selected;
                                count := Text {
                                    text: root.scripts.length; color: Theme.muted;
                                    font-size: Theme.font-caption;
                                    horizontal-alignment: center; vertical-alignment: center;
                                }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        ToolButton {
                            icon: "builtin:plus"; kind: "ghost"; enabled: !root.busy;
                            accessible-label: I18n.text("new");
                            clicked => { root.create(); }
                        }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: start; spacing: 2px;
                            for row[index] in root.scripts: ScriptItem {
                                script: row;
                                selected: index == root.selected;
                                enabled: !root.busy;
                                clicked => { root.choose(index); }
                            }
                            if root.scripts.length == 0: Text {
                                text: I18n.text("empty"); color: Theme.muted;
                                font-size: Theme.font-small; wrap: word-wrap;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }
            Rectangle { width: 1px; background: Theme.border; }

            // Editor for the selected or new script.
            VerticalLayout {
                padding: 24px; padding-top: 20px; spacing: 18px;
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center; spacing: 4px;
                        Text {
                            text: root.saved && root.script-name != "" ? root.script-name : I18n.text("new");
                            color: Theme.foreground; font-size: Theme.font-heading + 4px; font-weight: 600;
                            overflow: elide;
                        }
                        HorizontalLayout {
                            spacing: 6px; alignment: start;
                            if root.dirty: VerticalLayout {
                                alignment: center;
                                Rectangle { width: 7px; height: 7px; border-radius: 3.5px; background: Theme.warning; }
                            }
                            Text {
                                text: root.dirty ? I18n.text("unsaved.badge")
                                    : root.saved ? (root.kind == 1 ? "CMD" : "PowerShell") + (root.alias == "" ? "" : "  ·  " + root.alias)
                                    : I18n.text("new.detail");
                                color: root.dirty ? Theme.warning : Theme.muted;
                                font-size: Theme.font-small;
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 8px;
                            ToolButton {
                                text: I18n.text("admin"); icon: "builtin:shield"; enabled: root.runnable;
                                clicked => { root.execute(true); }
                            }
                            ToolButton {
                                text: I18n.text("run"); icon: "builtin:play"; kind: "primary"; enabled: root.runnable;
                                clicked => { root.execute(false); }
                            }
                        }
                    }
                }

                GridLayout {
                    spacing-horizontal: 16px; spacing-vertical: 14px;
                    VerticalLayout {
                        row: 0; col: 0; spacing: 6px;
                        FieldLabel { text: I18n.text("field.name"); }
                        LineEdit { text <=> root.script-name; enabled: !root.busy; }
                    }
                    VerticalLayout {
                        row: 0; col: 1; spacing: 6px;
                        FieldLabel { text: I18n.text("field.alias"); }
                        LineEdit { text <=> root.alias; placeholder-text: I18n.text("alias.hint"); enabled: !root.busy; }
                    }
                    VerticalLayout {
                        row: 1; col: 0; spacing: 6px;
                        FieldLabel { text: I18n.text("field.type"); }
                        Segmented {
                            options: ["PowerShell (.ps1)", "CMD (.cmd)"];
                            current <=> root.kind; enabled: !root.busy;
                        }
                    }
                    VerticalLayout {
                        row: 1; col: 1; spacing: 6px;
                        FieldLabel { text: I18n.text("field.directory"); }
                        LineEdit { text <=> root.directory; placeholder-text: I18n.text("directory.hint"); enabled: !root.busy; }
                    }
                }

                VerticalLayout {
                    spacing: 6px; vertical-stretch: 1;
                    HorizontalLayout {
                        FieldLabel { text: I18n.text("field.content"); }
                        Rectangle { horizontal-stretch: 1; }
                        FieldLabel {
                            text: root.kind == 1 ? "script.cmd" : "script.ps1";
                            font-family: "Cascadia Mono"; color: Theme.placeholder;
                        }
                    }
                    TextEdit {
                        text <=> root.content; enabled: !root.busy; vertical-stretch: 1;
                        font-family: "Cascadia Mono"; font-size: Theme.font-body;
                        wrap: no-wrap;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center; horizontal-stretch: 1;
                        Text {
                            text: root.status; color: root.deleting ? Theme.warning : Theme.muted;
                            font-size: Theme.font-small; wrap: word-wrap;
                        }
                    }
                    ToolButton {
                        text: root.deleting ? I18n.text("delete.confirm") : I18n.text("delete");
                        icon: "builtin:trash"; kind: root.deleting ? "danger" : "ghost";
                        enabled: root.saved && !root.busy;
                        clicked => { root.remove(); }
                    }
                    ToolButton {
                        text: I18n.text("discard"); enabled: root.dirty && !root.busy;
                        clicked => { root.discard(); }
                    }
                    ToolButton {
                        text: I18n.text("save"); shortcut: "Ctrl+S"; icon: "builtin:check"; kind: "primary";
                        enabled: !root.busy;
                        clicked => { root.save(); }
                    }
                }
            }
        }
    }
}
