import { Theme } from "../../../ui/theme.slint";
import { Icon } from "../../../ui/components/icon.slint";

/// A rounded button sized to its content.
export component Button inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> enabled: true;
    /// "primary", "secondary" or "ghost".
    in property <string> kind: "secondary";
    in property <string> shortcut;
    callback clicked();
    private property <color> fg: !root.enabled ? Theme.disabled
        : root.kind == "ghost" && !touch.has-hover ? Theme.muted : Theme.foreground;
    height: 32px;
    width: layout.preferred-width;
    horizontal-stretch: 0;
    border-radius: 6px;
    border-width: root.kind == "secondary" ? 1px : 0px;
    border-color: Theme.border;
    background: !root.enabled ? (root.kind == "primary" ? Theme.primary.transparentize(0.6) : transparent)
        : root.kind == "primary" ? (touch.has-hover ? Theme.primary-hover : Theme.primary)
        : touch.pressed ? Theme.selected
        : touch.has-hover ? Theme.hover
        : root.kind == "ghost" ? transparent : Theme.panel;
    animate background { duration: 90ms; }
    layout := HorizontalLayout {
        padding-left: root.text == "" ? 8px : 12px;
        padding-right: root.text == "" ? 8px : 14px;
        spacing: 7px;
        alignment: center;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon { name: root.icon; width: 14px; height: 14px; tint: root.fg; }
        }
        if root.text != "": Text {
            text: root.text; color: root.fg; font-size: Theme.font-body;
            vertical-alignment: center;
        }
        if root.shortcut != "": Text {
            text: root.shortcut; color: root.fg.transparentize(0.4); font-size: Theme.font-caption;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
}

/// An on/off switch.
export component Toggle inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    in property <string> label;
    callback toggled(bool);
    width: 38px;
    height: 22px;
    border-radius: self.height / 2;
    background: root.checked ? (root.enabled ? Theme.primary-hover : Theme.primary.transparentize(0.5))
        : touch.has-hover && root.enabled ? Theme.control-border : Theme.border;
    animate background { duration: 120ms; }
    knob := Rectangle {
        width: 16px; height: 16px; border-radius: 8px;
        y: (parent.height - self.height) / 2;
        x: root.checked ? parent.width - self.width - 3px : 3px;
        background: root.enabled ? #ffffff : Theme.disabled;
        animate x { duration: 140ms; easing: ease-out; }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}
