// 翻译插件配置。复制为 %LOCALAPPDATA%\MyTools\translator\config.json 后修改；支持 // 和 /* */ 注释。
// 修改后无需重启，下一次翻译或朗读时生效。API 密钥只从环境变量 DEEPSEEK_API_KEY 读取。
{
  // OpenAI 兼容的对话接口地址，插件会请求 <base_url>/chat/completions。
  //   "https://api.deepseek.com"  DeepSeek 官方（默认）
  //   其他兼容服务填写其根地址，例如 "https://example.com/v1"
  "base_url": "https://api.deepseek.com",

  // 模型名称；环境变量 DEEPSEEK_MODEL 优先于此项。
  //   "deepseek-flash"  默认，速度快
  //   其他取值以所用服务的模型列表为准
  "model": "deepseek-flash",

  // 本地保存最近多少条翻译（按翻译时间，满了先删最早的）。
  // 命中缓存时直接显示译文、不再请求 API；只输入 "tr " 时列出这些记录。
  //   0      不缓存，也不保存历史
  //   100    默认
  //   1~1000 建议范围；缓存文件在 %LOCALAPPDATA%\MyTools\translator\cache.json
  "cache_size": 100,

  // 单个英文单词的朗读，使用系统自带语音，离线可用。
  "speech": {
    // 朗读所用语音：
    //   "auto"                     自动选择已安装的美式英语语音（默认）
    //   "Microsoft Zira Desktop"   Windows 女声
    //   "Microsoft David Desktop"  Windows 男声
    //   macOS 可填 "Samantha"、"Daniel" 等，终端运行 say -v ? 查看全部
    // Windows 已安装的语音见 设置 > 时间和语言 > 语音。
    "voice": "auto",

    // 语速，整数 -10（最慢）到 10（最快）：
    //   0   正常语速（默认）
    //   -3  稍慢，适合听清发音
    //   3   稍快
    "rate": 0
  }
}
