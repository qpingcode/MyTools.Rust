import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { TextEditing } from "../text-editing.slint";

/// A themed multi-line text field that scrolls to keep the cursor visible. Read-only text
/// can still be selected and copied with Ctrl+C.
export component TextArea inherits Rectangle {
    out property <bool> composing: input.preedit-text != "";
    in-out property <string> text;
    in property <bool> read-only;
    in property <string> placeholder;
    /// Draws its own background and border; turn off inside a panel that already has them.
    in property <bool> framed: true;
    /// Ctrl+Enter (Cmd+Enter) starts a new line like Shift+Enter, for a field where Enter
    /// runs something instead.
    in property <bool> ctrl-enter-newline;
    callback edited(string);
    forward-focus: input;
    public function focus-input() { input.focus(); }
    background: root.framed ? Theme.preview : transparent;
    border-radius: Theme.radius;
    border-width: root.framed ? 1px : 0px;
    border-color: input.has-focus && !root.read-only ? Theme.control-border : Theme.border;

    scroll := ScrollView {
        x: root.framed ? 12px : 0px;
        y: root.framed ? 10px : 0px;
        width: parent.width - 2 * self.x;
        height: parent.height - 2 * self.y;
        content-width: self.visible-width;
        content-height: input.height;
        input := TextInput {
            width: scroll.visible-width;
            height: max(scroll.visible-height, self.preferred-height);
            text <=> root.text;
            read-only: root.read-only;
            single-line: false;
            wrap: word-wrap;
            color: Theme.foreground;
            font-size: Theme.font-body;
            selection-background-color: Theme.selection;
            edited => { root.edited(self.text); }
            key-pressed(event) => {
                if (root.ctrl-enter-newline && !root.read-only && event.text == Key.Return
                        && (event.modifiers.control || event.modifiers.meta)
                        && !event.modifiers.shift && !event.modifiers.alt) {
                    // TextInput ignores text typed with Ctrl, so the line break is put in here.
                    let start = min(self.anchor-position-byte-offset, self.cursor-position-byte-offset);
                    let end = max(self.anchor-position-byte-offset, self.cursor-position-byte-offset);
                    self.text = TextEditing.replace(self.text, start, end, "\n");
                    self.set-selection-offsets(start + 1, start + 1);
                    root.edited(self.text);
                    return accept;
                }
                reject
            }
            cursor-position-changed(position) => {
                if (position.y + scroll.content-y < 0px) {
                    scroll.content-y = -position.y;
                } else if (position.y + self.font-size * 1.6 + scroll.content-y > scroll.visible-height) {
                    scroll.content-y = min(0px, scroll.visible-height - position.y - self.font-size * 1.6);
                }
            }
        }
    }
    if root.text == "" && input.preedit-text == "" && root.placeholder != "": Text {
        x: scroll.x; y: scroll.y; width: scroll.width;
        text: root.placeholder; color: Theme.placeholder; font-size: Theme.font-body;
        wrap: word-wrap;
    }
}
