import { Theme } from "../theme.slint";

export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <string> shortcut;
    in property <bool> enabled: true;
    callback clicked();
    width: min(200px, max(72px, label.preferred-width + 28px + (root.shortcut == "" ? 0px : shortcut-label.preferred-width + 12px)));
    height: 34px;
    border-radius: 5px;
    border-width: 1px;
    border-color: root.enabled ? #555555 : #3b3b3b;
    background: touch.has-hover && root.enabled ? Theme.selected : transparent;
    label := Text {
        x: 12px; height: parent.height;
        width: parent.width - 24px - (root.shortcut == "" ? 0px : shortcut-label.preferred-width + 12px);
        text: root.text; font-size: 15px;
        color: root.enabled ? Theme.foreground : #707070;
        vertical-alignment: center; horizontal-alignment: center; overflow: elide;
    }
    shortcut-label := Text {
        x: parent.width - self.preferred-width - 12px; width: self.preferred-width; height: parent.height;
        text: root.shortcut; font-size: 12px; color: root.enabled ? Theme.muted : #666666;
        vertical-alignment: center;
        visible: root.shortcut != "";
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
}
