// Shared visual configuration: every color, font size and metric used by the UI lives here.
// Defaults can be overridden at startup through the `theme` object in the host config.json
// (keys use the property names below, e.g. "font-title": 14, "accent": "#94ded1").
export global Theme {
    // Surface colors
    in-out property <color> background: #1f1f1f;
    in-out property <color> panel: #282828;
    in-out property <color> preview: #242424;
    in-out property <color> popup: #292929;
    in-out property <color> border: #393939;
    in-out property <color> control-border: #555555;
    in-out property <color> control-border-disabled: #3b3b3b;
    in-out property <color> selected: #393939;
    in-out property <color> hover: #333333;
    in-out property <color> popup-selected: #414141;
    in-out property <color> popup-hover: #353535;
    in-out property <color> icon-background: #304646;
    // Text colors
    in-out property <color> foreground: #f4f4f4;
    in-out property <color> muted: #a3a3a3;
    in-out property <color> placeholder: #777777;
    in-out property <color> disabled: #707070;
    in-out property <color> accent: #94ded1;
    in-out property <color> selection: #37685e;
    // Buttons and status
    in-out property <color> primary: #37685e;
    in-out property <color> primary-hover: #427d71;
    in-out property <color> button-hover: #454545;
    in-out property <color> success: #4bb976;
    in-out property <color> warning: #e09a53;
    // Plugin states: starting and failed (running uses `success`).
    in-out property <color> pending: #e0c15a;
    in-out property <color> danger: #e5675f;

    // Font sizes
    in-out property <length> font-search: 18px;
    in-out property <length> font-heading: 16px;
    in-out property <length> font-title: 14px;
    in-out property <length> font-body: 13px;
    in-out property <length> font-small: 12px;
    in-out property <length> font-caption: 11px;

    // Metrics
    in-out property <length> search-height: 64px;
    in-out property <length> status-height: 44px;
    in-out property <length> row-height: 52px;
    in-out property <length> row-spacing: 4px;
    in-out property <length> icon-box: 30px;
    in-out property <length> icon-size: 20px;
    in-out property <length> action-row-height: 32px;
    in-out property <length> button-height: 28px;
    in-out property <length> radius: 8px;
}
