export global Theme {
    out property <color> background: #1f1f1f;
    out property <color> panel: #282828;
    out property <color> border: #393939;
    out property <color> selected: #393939;
    out property <color> foreground: #f4f4f4;
    out property <color> muted: #a3a3a3;
    out property <color> accent: #94ded1;
}
