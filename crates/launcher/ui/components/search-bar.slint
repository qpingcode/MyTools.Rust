import { I18n } from "../../../../ui/i18n.slint";
import { Theme } from "../../../../ui/theme.slint";
import { WindowDragArea } from "../../../../ui/components/window-drag-area.slint";

export component SearchBar inherits Rectangle {
    in-out property <string> query;
    callback edited(string);
    callback accepted();
    callback navigate(int);
    callback drag-requested();
    forward-focus: input;
    height: Theme.search-height;
    background: transparent;

    public function focus-input() { input.focus(); }
    public function focus-input-select-all() {
        input.focus();
        input.select-all();
    }
    public function focus-input-at-end() {
        input.focus();
        input.set-selection-offsets(input.text.character-count, input.text.character-count);
    }

    WindowDragArea {
        x: 0px; y: 0px; width: parent.width; height: input.y;
        drag-requested => { root.drag-requested(); }
    }
    WindowDragArea {
        x: 0px; y: input.y + input.height; width: parent.width; height: parent.height - self.y;
        drag-requested => { root.drag-requested(); }
    }
    WindowDragArea {
        x: 0px; y: input.y; width: input.x; height: input.height;
        drag-requested => { root.drag-requested(); }
    }
    WindowDragArea {
        x: input.x + input.width; y: input.y; width: parent.width - self.x; height: input.height;
        drag-requested => { root.drag-requested(); }
    }

    Image {
        x: 22px; y: (parent.height - self.height) / 2;
        width: Theme.font-search; height: Theme.font-search;
        source: @image-url("../../../../ui/assets/search.svg");
    }
    Text {
        x: input.x; y: input.y; width: input.width; height: input.height;
        text: I18n.text("search.placeholder"); color: Theme.placeholder; font-size: Theme.font-search;
        vertical-alignment: center;
        visible: root.query == "";
    }
    input := TextInput {
        x: 22px + Theme.font-search + 16px; y: (parent.height - self.height) / 2;
        width: parent.width - self.x - 22px; height: Theme.font-search * 1.6;
        text <=> root.query;
        color: Theme.foreground; font-size: Theme.font-search;
        vertical-alignment: center;
        single-line: true;
        input-type: search;
        selection-background-color: Theme.selection;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(); }
        key-pressed(event) => {
            if (event.text == Key.UpArrow) { root.navigate(-1); return accept; }
            if (event.text == Key.DownArrow) { root.navigate(1); return accept; }
            reject
        }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
}
