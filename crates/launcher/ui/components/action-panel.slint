import { Theme } from "../../../../ui/theme.slint";
import { Icon } from "../../../../ui/components/icon.slint";
import { ActionData } from "../types.slint";

export component ActionPanel inherits Rectangle {
    in property <[ActionData]> actions;
    in property <int> selected;
    in property <string> target-title;
    in property <length> available-height;
    callback execute(int);
    private property <length> pitch: Theme.action-row-height + 2px;
    width: 300px;
    height: min(root.available-height, root.actions.length * root.pitch + 44px);
    background: Theme.popup;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.control-border;
    // This surface consumes clicks so only clicks outside the panel dismiss it.
    TouchArea {}
    Text {
        x: 14px; y: 8px; height: 24px; width: parent.width - 28px;
        text: root.target-title; color: Theme.muted; font-size: Theme.font-small;
        vertical-alignment: center; overflow: elide;
    }
    list := Flickable {
        x: 6px; y: 36px; width: parent.width - 12px; height: parent.height - 42px;
        content-width: self.width;
        content-height: root.actions.length * root.pitch;
        for action[index] in root.actions: Rectangle {
            x: 0px; y: index * root.pitch; width: list.width; height: Theme.action-row-height;
            border-radius: 5px;
            background: index == root.selected ? Theme.popup-selected : (touch.has-hover ? Theme.popup-hover : transparent);
            Icon {
                x: 12px; y: (parent.height - self.height) / 2; width: 16px; height: 16px;
                name: action.icon;
            }
            Text {
                x: 40px; width: parent.width - 52px; height: parent.height;
                text: action.title; color: Theme.foreground; font-size: Theme.font-body;
                vertical-alignment: center; overflow: elide;
            }
            touch := TouchArea { mouse-cursor: pointer; clicked => { root.execute(index); } }
            accessible-role: button;
            accessible-label: action.title;
            accessible-action-default => { root.execute(index); }
        }
    }
    changed selected => {
        if (root.selected * root.pitch < -list.content-y) { list.content-y = -root.selected * root.pitch; }
        else if ((root.selected + 1) * root.pitch > -list.content-y + list.height) {
            list.content-y = min(0px, list.height - (root.selected + 1) * root.pitch);
        }
    }
}
