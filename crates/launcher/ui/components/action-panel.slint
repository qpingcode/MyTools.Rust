import { Theme } from "../../../../ui/theme.slint";
import { I18n } from "../../../../ui/i18n.slint";
import { Icon } from "../../../../ui/components/icon.slint";
import { ActionData } from "../types.slint";

export component ActionPanel inherits Rectangle {
    in property <[ActionData]> actions;
    in property <int> selected;
    in property <string> target-title;
    in property <length> available-height;
    callback execute(int);
    callback activate();
    callback navigate(int);
    callback filter-edited(string);
    public function focus-filter() {
        filter.text = "";
        filter.focus();
    }
    private property <length> pitch: Theme.action-row-height + 2px;
    width: 320px;
    height: min(root.available-height, max(1, root.actions.length) * root.pitch + 84px);
    background: Theme.popup;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.control-border;
    // This surface consumes clicks so only clicks outside the panel dismiss it.
    TouchArea {}
    Text {
        x: 14px; y: 8px; height: 24px; width: parent.width - 28px;
        text: root.target-title; color: Theme.muted; font-size: Theme.font-small;
        vertical-alignment: center; overflow: elide;
    }
    Rectangle {
        x: 10px; y: 36px; width: parent.width - 20px; height: 32px;
        border-width: 1px;
        border-color: filter.has-focus ? Theme.control-border : Theme.border;
        border-radius: 5px;
        background: Theme.preview;
        Icon {
            x: 8px; y: 8px; width: 16px; height: 16px;
            name: "builtin:search"; tint: Theme.muted;
        }
        if filter.text == "" && filter.preedit-text == "": Text {
            x: filter.x; y: 0px; width: filter.width; height: parent.height;
            text: I18n.text("actions.filter"); color: Theme.placeholder;
            font-size: Theme.font-small; vertical-alignment: center;
        }
        filter := TextInput {
            x: 31px; y: 0px; width: parent.width - self.x - 8px; height: parent.height;
            single-line: true; input-type: search;
            font-size: Theme.font-small; color: Theme.foreground; vertical-alignment: center;
            selection-background-color: Theme.selection;
            accessible-label: I18n.text("actions.filter");
            edited => { root.filter-edited(self.text); }
            key-pressed(event) => {
                if (self.preedit-text != "") { return reject; }
                if (event.text == Key.UpArrow) { root.navigate(-1); return accept; }
                if (event.text == Key.DownArrow) { root.navigate(1); return accept; }
                if (event.text == Key.Return) { root.activate(); return accept; }
                reject
            }
        }
    }
    if root.actions.length == 0: Text {
        x: 14px; y: 76px; width: parent.width - 28px; height: root.pitch;
        text: I18n.text("actions.no_matches"); color: Theme.muted;
        font-size: Theme.font-small; vertical-alignment: center;
    }
    list := Flickable {
        x: 6px; y: 76px; width: parent.width - 12px; height: max(0px, parent.height - 82px);
        content-width: self.width;
        content-height: root.actions.length * root.pitch;
        for action[index] in root.actions: Rectangle {
            x: 0px; y: index * root.pitch; width: list.width; height: Theme.action-row-height;
            border-radius: 5px;
            background: index == root.selected ? Theme.popup-selected : (touch.has-hover ? Theme.popup-hover : transparent);
            Icon {
                x: 12px; y: (parent.height - self.height) / 2; width: 16px; height: 16px;
                name: action.icon;
            }
            Text {
                x: 40px; width: parent.width - 52px; height: parent.height;
                text: action.title; color: Theme.foreground; font-size: Theme.font-body;
                vertical-alignment: center; overflow: elide;
            }
            touch := TouchArea { mouse-cursor: pointer; clicked => { root.execute(index); } }
            accessible-role: button;
            accessible-label: action.title;
            accessible-action-default => { root.execute(index); }
        }
    }
    changed actions => { list.content-y = 0px; }
    changed selected => {
        if (root.selected * root.pitch < -list.content-y) { list.content-y = -root.selected * root.pitch; }
        else if ((root.selected + 1) * root.pitch > -list.content-y + list.height) {
            list.content-y = min(0px, list.height - (root.selected + 1) * root.pitch);
        }
    }
}
