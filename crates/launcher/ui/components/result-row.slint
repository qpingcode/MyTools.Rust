import { Theme } from "../../../../ui/theme.slint";
import { ResultData } from "../types.slint";
import { Icon } from "../../../../ui/components/icon.slint";
import { TextFit } from "../text-fit.slint";

export component ResultRow inherits Rectangle {
    in property <ResultData> result;
    in property <bool> selected;
    callback clicked();
    callback activated();
    /// The pointer moved far enough while pressed on a draggable result.
    callback drag-started();
    // Set once per press, so one press starts at most one drag.
    private property <bool> dragging;
    private property <length> text-x: 14px + Theme.icon-box + 12px;
    height: Theme.row-height;
    border-radius: Theme.radius;
    background: root.selected ? Theme.selected : (touch.has-hover ? Theme.hover : transparent);
    Rectangle {
        x: 14px; y: (parent.height - self.height) / 2;
        width: Theme.icon-box; height: Theme.icon-box;
        background: Theme.icon-background; border-radius: 6px;
        Icon {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: Theme.icon-size; height: Theme.icon-size;
            name: root.result.icon; source: root.result.native-image;
        }
    }
    private property <length> text-width: root.width - root.text-x - 14px;
    // Rows with a match use StyledText, which colors it but cannot elide; others keep Text.
    if !root.result.title-highlighted: Text {
        x: root.text-x; y: root.height / 2 - self.height; width: root.text-width;
        height: Theme.font-title * 1.5;
        text: root.result.title; color: Theme.foreground; font-size: Theme.font-title;
        vertical-alignment: bottom; overflow: elide;
    }
    if root.result.title-highlighted: StyledText {
        x: root.text-x; y: root.height / 2 - self.height; width: root.text-width;
        height: Theme.font-title * 1.5;
        text: TextFit.highlight(root.result.title, root.result.query, Theme.accent,
            self.width, Theme.font-title);
        default-color: Theme.foreground; default-font-size: Theme.font-title;
        vertical-alignment: bottom; max-lines: 1;
    }
    if !root.result.description-highlighted: Text {
        x: root.text-x; y: root.height / 2 + 1px; width: root.text-width;
        height: Theme.font-small * 1.5;
        text: TextFit.path(root.result.description, self.width, Theme.font-small);
        color: Theme.muted; font-size: Theme.font-small;
        vertical-alignment: top; overflow: elide;
    }
    if root.result.description-highlighted: StyledText {
        x: root.text-x; y: root.height / 2 + 1px; width: root.text-width;
        height: Theme.font-small * 1.5;
        text: TextFit.highlight(TextFit.path(root.result.description, self.width,
            Theme.font-small), root.result.query, Theme.accent, self.width, Theme.font-small);
        default-color: Theme.muted; default-font-size: Theme.font-small;
        vertical-alignment: top; max-lines: 1;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        double-clicked => { root.activated(); }
        moved => {
            if self.pressed && root.result.draggable && !root.dragging
                && (abs(self.mouse-x - self.pressed-x) > 6px
                    || abs(self.mouse-y - self.pressed-y) > 6px) {
                root.dragging = true;
                root.drag-started();
            }
        }
        changed pressed => {
            if !self.pressed {
                root.dragging = false;
            }
        }
    }
    accessible-role: list-item;
    accessible-label: result.title;
    accessible-action-default => { root.activated(); }
}
