export { I18n } from "../../../ui/i18n.slint";
import { I18n } from "../../../ui/i18n.slint";
import { Theme } from "../../../ui/theme.slint";
import { SearchBar } from "components/search-bar.slint";
import { ResultRow } from "components/result-row.slint";
import { DetailPreview } from "components/detail-preview.slint";
import { EditorPane } from "components/editor-pane.slint";
import { ChatPane } from "components/chat-pane.slint";
import { StatusBar } from "components/status-bar.slint";
import { ActionPanel } from "components/action-panel.slint";
import { WindowResizeHandles } from "../../../ui/components/window-resize-handles.slint";
import { AboutSlint } from "std-widgets.slint";
import { ResultData, ActionData, ChatMessageData } from "types.slint";
export { ResultData, ActionData, ChatMessageData, ChatBlock } from "types.slint";
export { AppTray } from "tray.slint";
export { RestartDialog } from "restart-dialog.slint";
export { NoticeWindow, NoticeData } from "notice.slint";
export { ToastWindow } from "toast.slint";
export { Theme } from "../../../ui/theme.slint";
export { TextFit } from "text-fit.slint";

export component MainWindow inherits Window {
    title: "MyTools";
    icon: @image-url("../../../ui/assets/app.png");
    preferred-width: 780px; preferred-height: 520px;
    min-width: 560px; min-height: 320px;
    no-frame: true;
    background: Theme.background;
    in property <string> app-font-family;
    default-font-family: root.app-font-family;
    in-out property <string> query;
    in property <[ResultData]> results;
    in property <int> selected: 0;
    in property <string> status;
    in property <bool> failed;
    in property <bool> searching: true;
    /// Why the list is empty, e.g. which plugin returned nothing.
    in property <string> empty-text;
    /// Status text while a search runs, e.g. "Searching Everything…".
    in property <string> searching-status: I18n.text("search.loading");
    /// The worker is querying plugins (set when input has settled, not on each keystroke).
    /// Startup counts as running while plugins load.
    in property <bool> search-running: true;
    /// Status text while an action runs, e.g. "Translating…".
    in property <string> action-status;
    /// Searches and actions that finish quickly never show the indicator; once shown it
    /// stays until both are done, even while the user keeps typing.
    out property <bool> show-loading;
    in property <[ActionData]> actions;
    in-out property <bool> actions-open;
    in-out property <int> selected-action: 0;
    in property <string> action-target;
    in property <string> primary-title: I18n.text("actions.execute");
    in property <string> shortcut-label: "Ctrl+K";
    in property <bool> actions-available;
    in property <bool> primary-available;
    in-out property <bool> action-busy;
    in property <bool> detail-view;
    /// The `editor` view: a multi-line input beside the first result.
    in property <bool> editor-view;
    /// What the editor holds: set from the search box, edited without changing it. The
    /// chat view's input holds it too.
    in-out property <string> editor-text;
    /// The `chat` view: a conversation with an input under it.
    in property <bool> chat-view;
    in property <[ChatMessageData]> chat-messages;
    /// An answer is being written; Esc stops it.
    in property <bool> chat-busy;
    in property <string> preview-title;
    in property <string> preview-text;
    in property <string> preview-metadata;
    in property <image> preview-image;
    callback search(string);
    /// The editor's text changed; searches it after the alias of the search box.
    callback editor-edited(string);
    /// Sends the chat input as the next question.
    callback chat-send(string);
    callback chat-stop();
    callback copy-text(string);
    callback open-link(string);
    /// Tab in the search box: opens the plugin that takes it with what was typed; `false`
    /// when there is none, or the query is in a plugin's scope.
    callback tab-pressed() -> bool;
    /// Searches the newest query again, e.g. after an action asked for fresh results.
    callback refresh();
    callback execute(int);
    callback select-result(int);
    /// Drag this result's file out of the window.
    callback drag-result(int);
    callback show-license();
    callback navigate(int);
    callback dismiss();
    callback drag-requested();
    /// Edge or corner being dragged: "n", "s", "e", "w", "ne", "nw", "se" or "sw".
    callback resize-requested(string);
    callback toggle-actions();
    callback close-actions();
    callback navigate-action(int);
    callback execute-action(int);
    private property <length> row-pitch: Theme.row-height + Theme.row-spacing;
    forward-focus: keyboard;
    changed searching => { if (!self.searching && !self.action-busy) { self.show-loading = false; } }
    changed action-busy => { if (!self.action-busy && !self.searching) { self.show-loading = false; } }
    loading-delay := Timer {
        interval: 150ms;
        running: (root.action-busy || (root.searching && root.search-running)) && !root.show-loading;
        triggered => { root.show-loading = true; }
    }
    public function focus-search() { search-bar.focus-input(); }
    public function focus-search-select-all() { search-bar.focus-input-select-all(); }
    public function focus-search-at-end() { search-bar.focus-input-at-end(); }
    public function focus-editor() { editor.focus-input(); }
    public function focus-chat() { chat.focus-input(); }
    public function chat-scroll-to-end(force: bool) { chat.scroll-to-end(force); }
    public function reset-scroll() { list.content-y = 0px; }

    keyboard := FocusScope {
        forward-focus: search-bar;
        KeyBinding { keys: @keys(Control + K); activated => { root.toggle-actions(); } }
        KeyBinding { keys: @keys(F1); activated => { root.show-license(); } }
        capture-key-pressed(event) => {
            if (event.text == Key.Escape) { root.dismiss(); return accept; }
            // In the editor Enter starts a new line, so Ctrl+Enter (Cmd+Enter) runs the result.
            if (root.editor-view && !root.actions-open && event.text == Key.Return
                    && (event.modifiers.control || event.modifiers.meta)) {
                root.execute(root.selected);
                return accept;
            }
            if (event.text == Key.Tab && !event.modifiers.shift && !event.modifiers.control
                    && !root.editor-view && !root.chat-view && !root.actions-open) {
                if (root.tab-pressed()) { return accept; }
            }
            if (root.actions-open) {
                if (event.text == Key.UpArrow) { root.navigate-action(-1); return accept; }
                if (event.text == Key.DownArrow) { root.navigate-action(1); return accept; }
                if (event.text == Key.Return) { root.execute-action(root.selected-action); return accept; }
            }
            reject
        }
        Rectangle {
            border-width: 1px; border-color: Theme.border; border-radius: Theme.radius + 4px;
            background: Theme.background;
            search-bar := SearchBar {
                x: 0px; y: 0px;
                width: parent.width;
                query <=> root.query;
                loading: root.show-loading;
                edited(query) => { root.search(query); }
                accepted => {
                    if (root.chat-view) { root.chat-send(root.editor-text); }
                    else { root.execute(root.selected); }
                }
                // With a single result, Down moves into the editor instead.
                navigate(delta) => {
                    if (root.chat-view) {
                        if (delta > 0) { chat.focus-input(); }
                    } else if (root.editor-view && delta > 0) {
                        editor.focus-input();
                    } else {
                        root.navigate(delta);
                    }
                }
                drag-requested => { root.drag-requested(); }
            }
            list := Flickable {
                visible: !root.editor-view && !root.chat-view;
                x: 1px; y: Theme.search-height + 1px; width: root.detail-view ? parent.width * 0.44 : parent.width - 2px;
                height: parent.height - Theme.search-height - Theme.status-height - 2px;
                content-width: self.width;
                content-height: max(self.height, root.results.length * root.row-pitch + 16px);
                for result[index] in root.results: ResultRow {
                    x: 8px; y: 8px + index * root.row-pitch; width: list.width - 16px;
                    result: result; selected: index == root.selected;
                    clicked => { root.select-result(index); }
                    activated => { root.execute(index); }
                    drag-started => { root.drag-result(index); }
                }
            }
            if root.detail-view: DetailPreview {
                x: list.width + 8px; y: Theme.search-height + 9px;
                width: parent.width - self.x - 10px; height: parent.height - Theme.search-height - Theme.status-height - 18px;
                title: root.preview-title; text: root.preview-text;
                metadata: root.preview-metadata; picture: root.preview-image;
            }
            editor := EditorPane {
                y: Theme.search-height;
                width: parent.width;
                height: parent.height - Theme.search-height - Theme.status-height;
                visible: root.editor-view;
                text <=> root.editor-text;
                // A result with text shows the text alone; title and description are for
                // prompts and errors, such as "Ctrl+Enter translates".
                result-title: root.results.length > 0 && root.preview-text == ""
                    ? root.results[0].title : "";
                result-description: root.results.length > 0 && root.preview-text == ""
                    ? root.results[0].description : "";
                result-text: root.preview-text;
                empty-text: root.searching ? "" : root.empty-text;
                edited(text) => { root.editor-edited(text); }
            }
            chat := ChatPane {
                y: Theme.search-height;
                width: parent.width;
                height: parent.height - Theme.search-height - Theme.status-height;
                visible: root.chat-view;
                messages: root.chat-messages;
                busy: root.chat-busy;
                text <=> root.editor-text;
                send(text) => { root.chat-send(text); }
                stop => { root.chat-stop(); }
                copy-text(text) => { root.copy-text(text); }
                open-link(url) => { root.open-link(url); }
            }
            if root.results.length == 0 && !root.searching && !root.editor-view && !root.chat-view: Text {
                x: 28px; y: Theme.search-height + 20px; text: root.empty-text;
                color: Theme.muted; font-size: Theme.font-body;
            }
            StatusBar {
                y: parent.height - self.height; width: parent.width;
                status: !root.show-loading ? root.status
                    : root.action-busy && root.action-status != "" ? root.action-status
                    : root.searching-status != "" ? root.searching-status : root.status;
                failed: root.failed && !root.show-loading;
                loading: root.show-loading;
                primary-title: root.primary-title;
                shortcut-label: root.shortcut-label;
                primary-shortcut: root.editor-view ? "Ctrl+Enter" : root.chat-view && root.chat-busy ? "Esc" : "Enter";
                actions-available: root.actions-available && !root.searching;
                primary-available: root.primary-available && !root.searching;
                busy: root.action-busy;
                execute => { root.execute(root.selected); }
                toggle-actions => { root.toggle-actions(); }
                drag-requested => { root.drag-requested(); }
            }
        }
        if root.actions-open: Rectangle {
            background: transparent;
            TouchArea { clicked => { root.close-actions(); } }
            ActionPanel {
                x: parent.width - self.width - 16px;
                y: parent.height - Theme.status-height - 8px - self.height;
                available-height: parent.height - Theme.status-height - Theme.search-height - 16px;
                actions: root.actions;
                selected: root.selected-action;
                target-title: root.action-target;
                execute(index) => { root.execute-action(index); }
            }
        }
        WindowResizeHandles {
            width: parent.width; height: parent.height;
            resize-requested(direction) => { root.resize-requested(direction); }
        }
    }
    changed selected => {
        if (root.selected * root.row-pitch + 8px < -list.content-y) {
            list.content-y = -root.selected * root.row-pitch;
        } else if ((root.selected + 1) * root.row-pitch + 8px > -list.content-y + list.height) {
            list.content-y = min(0px, list.height - (root.selected + 1) * root.row-pitch - 8px);
        }
    }
}

export component AboutWindow inherits Window {
    title: I18n.text("about.title");
    width: 440px; height: 330px;
    in property <string> app-font-family;
    default-font-family: root.app-font-family;
    VerticalLayout {
        padding: 24px; spacing: 16px;
        Text { text: "MyTools"; font-size: Theme.font-heading + 6px; }
        Text { text: I18n.text("app.description"); }
        AboutSlint {}
    }
}
