import { Theme } from "../../../ui/theme.slint";
import { I18n } from "../../../ui/i18n.slint";
import { AppButton } from "../../../ui/components/button.slint";

export component RestartDialog inherits Window {
    title: I18n.text("restart.title");
    width: 440px; height: 220px;
    background: Theme.background;
    in property <string> app-font-family;
    default-font-family: root.app-font-family;
    callback response(bool);
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) { root.response(false); return accept; }
            if (event.text == Key.Return) { root.response(true); return accept; }
            reject
        }
        VerticalLayout {
            padding: 24px; spacing: 18px;
            Text { text: I18n.text("restart.title"); color: Theme.foreground; font-size: 20px; }
            Text { text: I18n.text("restart.message"); color: Theme.muted; font-size: 15px; wrap: word-wrap; }
            Rectangle { vertical-stretch: 1; background: transparent; }
            HorizontalLayout {
                spacing: 12px;
                Rectangle { horizontal-stretch: 1; background: transparent; }
                AppButton { text: I18n.text("restart.later"); clicked => { root.response(false); } }
                AppButton { text: I18n.text("restart.now"); primary: true; clicked => { root.response(true); } }
            }
        }
    }
}
