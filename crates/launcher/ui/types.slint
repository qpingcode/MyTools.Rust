export struct ResultData {
    title: string,
    description: string,
    icon: string,
    native-path: string,
    native-image: image,
    /// A file, folder or shortcut on disk that can be dragged into other applications.
    draggable: bool,
    /// The query the results answer, for highlighting what it matched.
    query: string,
    title-highlighted: bool,
    description-highlighted: bool,
}

export struct ActionData { title: string, icon: string }

/// A block of a chat message: text (0), a heading (1), code (2), a quote (3) or a table (4).
export struct ChatBlock {
    kind: int,
    /// What the block shows (the code of a code block); empty for a table.
    plain: string,
    /// A code block's language, e.g. "rust"; may be empty.
    language: string,
    /// A table's cells, the header row first.
    rows: [[string]],
    /// Each table column's share of the width.
    widths: [float],
}

/// Something done for an answer, e.g. a web search; `state` is running (0), done (1) or
/// failed (2).
export struct ChatStep { text: string, state: int }

/// A page an answer cites as `[number]`.
export struct ChatSource { number: int, title: string, url: string, host: string }

export struct ChatMessageData {
    /// From the user; otherwise from the assistant.
    user: bool,
    blocks: [ChatBlock],
    /// The answer is still being written.
    streaming: bool,
    /// The answer failed; its text says why.
    error: bool,
    /// What the model thought before answering.
    reasoning: string,
    /// Text the question was asked about, e.g. a selection.
    attachment: string,
    steps: [ChatStep],
    sources: [ChatSource],
}
